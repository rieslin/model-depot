<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: a borderless window around Model Depot's page (WebView2), with an icon in the notification area.
       It targets .NET Framework 4.8, which Windows 10 and 11 already have, so nothing has to be installed. The built
       files go to app\ and are committed with the code, so a git pull brings the exe. Build with:
       dotnet build desktop\ModelDepot.csproj -c Release
       The icon is drawn by make_icon.py. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>ModelDepot</AssemblyName>
    <RootNamespace>ModelDepot</RootNamespace>
    <ApplicationIcon>ModelDepot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.6.0</Version>
    <Product>Model Depot</Product>
    <AssemblyTitle>Model Depot</AssemblyTitle>
    <OutputPath>app\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <DebugType>none</DebugType>
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <EmbeddedResource Include="ModelDepot.ico" LogicalName="ModelDepot.ico" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
  <!-- app\ keeps only what a WinForms window needs: no WPF control, and an x64 build finds WebView2Loader.dll beside
       the exe, so the per-platform copies are not needed -->
  <Target Name="KeepOnlyWhatTheWindowNeeds" AfterTargets="Build">
    <Delete Files="$(OutDir)Microsoft.Web.WebView2.Wpf.dll" />
    <RemoveDir Directories="$(OutDir)runtimes" />
  </Target>
</Project>
